# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WEBHOOK_SECRET: Token rahasia untuk verifikasi header X-Webhook-Secret dari Android Notification Forwarder (MacroDroid/Tasker).
WEBHOOK_SECRET="dana-qris-secret-2026"

# EMAIL DELIVERY (Pilih salah satu: Resend API atau SMTP Nodemailer)
RESEND_API_KEY=""
EMAIL_FROM="AYAM PETOK-PETOK Digital <no-reply@domainanda.com>"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# WHATSAPP GATEWAY (Kompatibel dengan Fonnte, Wablas, WAHA, atau Custom Webhook)
# Contoh Fonnte: WA_GATEWAY_URL="https://api.fonnte.com/send"
WA_GATEWAY_URL=""
WA_API_TOKEN=""
WA_PROVIDER="fonnte"

# REST API v1 & OUTBOUND WEBHOOK (Untuk integrasi aplikasi eksternal)
# Jika EXTERNAL_API_KEY diisi, semua request ke /api/v1/* wajib menyertakan header Authorization: Bearer <key> atau X-API-Key: <key>
EXTERNAL_API_KEY=""
# Secret untuk HMAC-SHA256 header X-MutasiPay-Signature pada webhook keluar
OUTBOUND_WEBHOOK_SECRET="mutasipay-webhook-signing-secret"
